# Copy to .env.local and change only what you need. Every variable is optional.
# Vite only exposes variables that start with VITE_, and they are PUBLIC: anyone can read
# them in the built site. Never put secrets, API keys or tokens in a VITE_ variable.

# Product name shown in the UI.
VITE_APP_NAME=GRANTLY

# Base URL of OUR OWN backend, for example https://api.example.org/v1
# Leave empty to run fully offline on the bundled scholarship data (the default).
# The browser talks only to our backend. Third-party APIs must be called from the
# server, with their keys kept in server-side environment variables.
VITE_API_BASE_URL=

# Give up on a backend request after this many milliseconds (default 8000).
VITE_API_TIMEOUT_MS=8000

# How long to reuse a backend response, in milliseconds (default 600000 = 10 minutes).
# Use 0 to turn caching off.
VITE_API_CACHE_MS=600000
